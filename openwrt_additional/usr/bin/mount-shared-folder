#!/bin/sh

MOUNT_TAG="shared"
MOUNT_POINT="/shared"
MAX_ATTEMPTS="${1:-10}"

is_mounted() {
    awk -v mount_point="$MOUNT_POINT" \
        '$2 == mount_point { found = 1 } END { exit !found }' /proc/mounts
}

# This fork treats /shared as required. Retry the mount itself: OpenWrt does
# not consistently expose the 9p mount tag through sysfs this early in boot.
attempt=0
mkdir -p "$MOUNT_POINT"
while [ "$attempt" -lt "$MAX_ATTEMPTS" ]; do
    is_mounted && exit 0
    mount -t 9p -o trans=virtio,version=9p2000.L,rw \
        "$MOUNT_TAG" "$MOUNT_POINT" 2>/dev/null && \
        is_mounted && exit 0
    attempt=$((attempt + 1))
    sleep 1
done

echo "Required virtfs mount tag '$MOUNT_TAG' could not be mounted" >&2
exit 1
